{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(fonts|uploads|img/avatars|img/about)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
